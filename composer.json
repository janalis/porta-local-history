{
    "name": "porta/local-history",
    "description": "Snapshots every save and restores one as a single undoable edit",
    "type": "porta-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "symfony/clock": "^8.2",
        "symfony/filesystem": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Porta\\LocalHistory\\": "src/"
        }
    },
    "extra": {
        "porta": {
            "tools": [
                {
                    "name": "git",
                    "role": "suggested",
                    "purpose": "diffs between snapshots",
                    "sources": [
                        [
                            "brew",
                            "git"
                        ]
                    ]
                }
            ]
        }
    }
}
